---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Tu armario digital personal. Organiza prendas, crea outfits y encuentra tu estilo.' } = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`;
const current = Astro.url.pathname.replace(base, '');
const isActive = (path: string) => (path === '' ? current === '' || current === '/' : current.startsWith(path));

const nav = [
  { path: '', label: 'Inicio', icon: 'home' as const },
  { path: 'armario/', label: 'Mi armario', icon: 'shirt' as const },
  { path: 'outfits/', label: 'Outfits', icon: 'layers' as const, pill: 'NEW' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}icon-192.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="MyOwnWardrobe" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <script is:inline>
      try {
        var saved = localStorage.getItem('mow-theme');
        document.documentElement.dataset.theme =
          saved === 'dark' || saved === 'light'
            ? saved
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <title>MyOwnWardrobe — {title}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar" id="sidebar">
        <div class="brand-row">
          <a href={href('')} class="brand">
            <div class="brand-mark"><Icon name="hanger" size={22} /></div>
            <span>
              <b>MyOwnWardrobe</b>
              <span>YOUR CLOSET, YOUR STYLE</span>
            </span>
          </a>
          <button id="menu-close" type="button" class="icon-btn menu-close" aria-label="Cerrar menú">
            <Icon name="close" size={16} />
          </button>
        </div>

        <div class="side-label">MENÚ</div>
        <nav>
          {
            nav.map((item) => (
              <a href={href(item.path)} class:list={['nav-link', isActive(item.path) && 'active']}>
                <Icon name={item.icon} size={17} />
                {item.label}
                {item.pill && <span class="new-pill">{item.pill}</span>}
              </a>
            ))
          }
        </nav>

        <div class="sidebar-bottom">
          <div class="sync-card">
            <div class="sync-icon"><Icon name="cloud" size={17} /></div>
            <span>
              <b>Mi cuenta</b>
              <span id="user-email">Sin iniciar sesión</span>
            </span>
          </div>
          <a id="btn-login" href={href('login/')} class="nav-link">
            <Icon name="user" size={17} /> Entrar
          </a>
          <button id="btn-logout" type="button" class="nav-link hidden">
            <Icon name="logout" size={17} /> Cerrar sesión
          </button>
          <div class="side-foot">MYOWNWARDROBE · 2026</div>
        </div>
      </aside>

      <div class="sidebar-backdrop hidden" id="sidebar-backdrop" aria-hidden="true"></div>

      <div class="main">
        <header class="topbar">
          <button id="menu-toggle" type="button" class="icon-btn menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
            <Icon name="menu" size={18} />
          </button>
          <div class="breadcrumb">MyOwnWardrobe <span>/</span> <b>{title}</b></div>
          <div class="top-actions">
            <div class="sync-status">
              <Icon name="check" size={16} />
              <span id="sync-status">Modo invitado</span>
            </div>
            <button id="theme-toggle" type="button" class="icon-btn" title="Cambiar tema" aria-label="Cambiar tema">
              <span class="icon-moon"><Icon name="moon" size={16} /></span>
              <span class="icon-sun"><Icon name="sun" size={16} /></span>
            </button>
          </div>
        </header>

        <div class="content">
          <slot />
        </div>

        <footer class="footer">
          <span>© 2026 MyOwnWardrobe · Todos los derechos reservados</span>
          <span><a href={href('armario/')}>Mi armario</a> · <a href={href('outfits/')}>Outfits</a> · <a href={href('login/')}>Mi cuenta</a></span>
          <span>Tu armario, tu estilo</span>
        </footer>
      </div>
    </div>

    <div class="modal-backdrop hidden" id="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-message">
      <div class="modal confirm-modal">
        <div class="confirm-icon"><Icon name="trash" size={22} /></div>
        <h2 id="confirm-title">¿Eliminar?</h2>
        <p id="confirm-message"></p>
        <div class="confirm-actions">
          <button type="button" id="confirm-cancel" class="outline-btn">Cancelar</button>
          <button type="button" id="confirm-accept" class="primary-btn danger-btn">Eliminar</button>
        </div>
      </div>
    </div>

    <script>
      import { getSupabase, signOut, supabaseConfigured } from '../lib/supabase';
      import { setupConfirmDialog } from '../lib/confirm';

      const emailEl = document.getElementById('user-email');
      const loginEl = document.getElementById('btn-login');
      const logoutEl = document.getElementById('btn-logout');
      const syncEl = document.getElementById('sync-status');
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const menuToggle = document.getElementById('menu-toggle');
      const menuClose = document.getElementById('menu-close');
      const themeToggle = document.getElementById('theme-toggle');

      const isMobile = () => window.matchMedia('(max-width: 760px)').matches;

      const isExpanded = () =>
        isMobile()
          ? sidebar?.classList.contains('show') ?? false
          : !document.body.classList.contains('sidebar-collapsed');

      const syncToggle = () => {
        const expanded = isExpanded();
        menuToggle?.setAttribute('aria-expanded', String(expanded));
        menuToggle?.setAttribute('aria-label', expanded ? 'Cerrar menú' : 'Abrir menú');
      };

      const setMenu = (open: boolean) => {
        if (isMobile()) {
          sidebar?.classList.toggle('show', open);
          if (sidebar) {
            sidebar.style.left = open ? '0px' : '-268px';
            sidebar.style.visibility = open ? 'visible' : 'hidden';
          }
          backdrop?.classList.toggle('hidden', !open);
          document.body.classList.toggle('menu-open', open);
        } else {
          document.body.classList.toggle('sidebar-collapsed', !open);
          document.body.classList.remove('menu-open');
          backdrop?.classList.add('hidden');
          sidebar?.classList.remove('show');
          sidebar?.style.removeProperty('left');
          sidebar?.style.removeProperty('visibility');
        }
        syncToggle();
      };

      window.addEventListener('resize', () => {
        document.body.classList.remove('menu-open');
        document.body.classList.remove('sidebar-collapsed');
        backdrop?.classList.add('hidden');
        sidebar?.classList.remove('show');
        sidebar?.style.removeProperty('left');
        sidebar?.style.removeProperty('visibility');
        syncToggle();
      });

      const render = (email?: string | null) => {
        if (email) {
          if (emailEl) emailEl.textContent = email;
          loginEl?.classList.add('hidden');
          logoutEl?.classList.remove('hidden');
          if (syncEl) syncEl.textContent = 'Sincronizado';
        } else {
          if (emailEl) emailEl.textContent = 'Sin iniciar sesión';
          loginEl?.classList.remove('hidden');
          logoutEl?.classList.add('hidden');
          if (syncEl) syncEl.textContent = 'Modo invitado';
        }
      };

      const doLogout = () => signOut().catch(() => {});
      logoutEl?.addEventListener('click', doLogout);

      const applyTheme = (theme: 'light' | 'dark') => {
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('mow-theme', theme);
        } catch {}
      };

      themeToggle?.addEventListener('click', () =>
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark')
      );

      menuToggle?.addEventListener('click', () => setMenu(!isExpanded()));
      menuClose?.addEventListener('click', () => setMenu(false));
      backdrop?.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isMobile()) setMenu(false);
      });
      document.querySelectorAll('.nav-link').forEach((link) =>
        link.addEventListener('click', () => {
          if (isMobile()) setMenu(false);
        })
      );

      syncToggle();

      if (supabaseConfigured) {
        try {
          const supabase = getSupabase();
          supabase.auth.getSession().then(({ data }) => render(data.session?.user.email));
          supabase.auth.onAuthStateChange((_event, session) => render(session?.user.email));
        } catch (error) {
          console.error(error);
        }
      }

      setupConfirmDialog();

      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${import.meta.env.BASE_URL}sw.js`, { scope: import.meta.env.BASE_URL })
            .catch(() => {});
        });
      }
    </script>
  </body>
</html>
