---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Outfits">
  <div class="page-heading">
    <div>
      <div class="eyebrow">ESTILISMO</div>
      <h1>Dress Me</h1>
      <p>Toca una prenda en cada fila o pulsa «Mezclar» para descubrir nuevos looks.</p>
    </div>
    <a href={`${base}armario/`} class="primary-btn">
      <Icon name="plus" size={16} /> Nueva prenda
    </a>
  </div>

  <p id="error" class="hidden msg error"></p>

  <section class="dm-panel" id="dm-panel">
    <div class="dm-toolbar">
      <div class="dm-toolbar-left">
        <button id="dm-filters-toggle" type="button" class="outline-btn" aria-expanded="false" aria-controls="dm-filters">
          <Icon name="sliders" size={15} /> Filtros
          <span id="dm-filter-count" class="dm-count hidden">0</span>
        </button>
        <span id="dm-counter" class="dm-counter">Cargando…</span>
      </div>
      <button id="dm-shuffle" type="button" class="primary-btn dm-shuffle">
        <Icon name="shuffle" size={16} /> Mezclar
      </button>
    </div>

    <div class="dm-filters hidden" id="dm-filters">
      <span class="dm-filter-label">TEMPORADA</span>
      <div class="dm-chips" id="dm-seasons"></div>
    </div>

    <div class="dm-rows" id="dm-rows">
      <div class="dm-row" data-row="top">
        <div class="dm-row-head">
          <span><b>SUPERIOR / ABRIGO</b><small>Camisetas, tops y chaquetas</small></span>
          <span class="dm-row-count" id="dm-count-top">0</span>
        </div>
        <div class="dm-track" id="dm-track-top" data-track="top"></div>
      </div>
      <div class="dm-row" data-row="bottom">
        <div class="dm-row-head">
          <span><b>INFERIOR</b><small>Pantalones, faldas y vaqueros</small></span>
          <span class="dm-row-count" id="dm-count-bottom">0</span>
        </div>
        <div class="dm-track" id="dm-track-bottom" data-track="bottom"></div>
      </div>
      <div class="dm-row" data-row="shoes">
        <div class="dm-row-head">
          <span><b>CALZADO</b><small>Zapatos, zapatillas y botas</small></span>
          <span class="dm-row-count" id="dm-count-shoes">0</span>
        </div>
        <div class="dm-track" id="dm-track-shoes" data-track="shoes"></div>
      </div>
      <div class="dm-row" data-row="accessory">
        <div class="dm-row-head">
          <span><b>ACCESORIO</b><small>Bolsos, cinturones y complementos</small></span>
          <span class="dm-row-count" id="dm-count-accessory">0</span>
        </div>
        <div class="dm-track" id="dm-track-accessory" data-track="accessory"></div>
      </div>
    </div>

    <div class="empty-state hidden" id="empty">
      <span class="empty-icon"><Icon name="hanger" size={23} /></span>
      <h3>Aún no hay prendas</h3>
      <p>Primero añade algunas prendas a tu armario para poder mezclarlas.</p>
      <a href={`${base}armario/`} class="primary-btn">Ir al armario <Icon name="arrow" size={14} /></a>
    </div>

    <div class="dm-bottom">
      <div class="outfit-preview">
        <div class="preview-head">
          <span>TU LOOK</span>
          <span id="selected-count">0 PRENDAS</span>
        </div>
        <div class="preview-collage" id="preview"></div>
      </div>
      <form class="save-form dm-save" id="save-form">
        <label>
          <span>NOMBRE DEL LOOK</span>
          <input id="outfit-name" type="text" maxlength="50" placeholder="Viernes de oficina" />
        </label>
        <button id="save-outfit" type="submit" class="primary-btn full" disabled>Guardar outfit</button>
      </form>
    </div>
  </section>

  <section class="section-block" style="margin-top:35px">
    <div class="section-head">
      <div>
        <h2>Mis outfits</h2>
        <p>Tus combinaciones guardadas</p>
      </div>
    </div>
    <div class="outfit-grid" id="list"></div>
    <div class="empty-state hidden" id="no-outfits">
      <span class="empty-icon"><Icon name="layers" size={23} /></span>
      <h3>Sin outfits todavía</h3>
      <p>Mezcla un look arriba y pulsa «Guardar outfit».</p>
    </div>
  </section>

  <p id="saved-msg" class="hidden msg ok"></p>

  <script>
    import { requireUser, supabaseConfigured, TEMPORADAS, type Outfit, type Prenda } from '../lib/supabase';
    import { deleteOutfit, esc, fetchOutfits, fetchPrendas, insertOutfit } from '../lib/wardrobe';

    type FilaId = 'top' | 'bottom' | 'shoes' | 'accessory';

    const FILAS: Record<FilaId, string[]> = {
      top: ['superior', 'abrigo'],
      bottom: ['inferior'],
      shoes: ['calzado'],
      accessory: ['accesorio'],
    };
    const FILA_DE: Record<string, FilaId> = {
      superior: 'top',
      abrigo: 'top',
      inferior: 'bottom',
      calzado: 'shoes',
      accesorio: 'accessory',
    };
    const EMOJI: Record<string, string> = {
      superior: '👕',
      inferior: '👖',
      abrigo: '🧥',
      calzado: '👟',
      accesorio: '🎒',
    };

    const panel = document.getElementById('dm-panel');
    const rowsEl = document.getElementById('dm-rows');
    const empty = document.getElementById('empty');
    const counter = document.getElementById('dm-counter');
    const chips = document.getElementById('dm-seasons');
    const filterCount = document.getElementById('dm-filter-count');
    const filters = document.getElementById('dm-filters');
    const filtersToggle = document.getElementById('dm-filters-toggle') as HTMLButtonElement | null;
    const shuffleButton = document.getElementById('dm-shuffle') as HTMLButtonElement | null;
    const preview = document.getElementById('preview');
    const selectedCount = document.getElementById('selected-count');
    const nameInput = document.getElementById('outfit-name') as HTMLInputElement | null;
    const saveForm = document.getElementById('save-form') as HTMLFormElement | null;
    const saveButton = document.getElementById('save-outfit') as HTMLButtonElement | null;
    const savedMsg = document.getElementById('saved-msg');
    const listEl = document.getElementById('list');
    const noOutfits = document.getElementById('no-outfits');
    const errorEl = document.getElementById('error');

    let prendas: Prenda[] = [];
    let outfits: Outfit[] = [];
    const seleccion = new Set<string>();
    const temporadas = new Set<string>();

    const showError = (text: string) => {
      if (!errorEl) return;
      errorEl.textContent = text;
      errorEl.classList.remove('hidden');
      setTimeout(() => errorEl.classList.add('hidden'), 6000);
    };

    const showSaved = (text: string) => {
      if (!savedMsg) return;
      savedMsg.textContent = text;
      savedMsg.classList.remove('hidden');
      setTimeout(() => savedMsg.classList.add('hidden'), 4000);
    };

    const visibles = () =>
      prendas.filter((p) => {
        if (!temporadas.size || temporadas.has('todo el año')) return true;
        const temporada = (p.temporada ?? '').toLowerCase().trim();
        return !temporada || temporada === 'todo el año' || temporadas.has(temporada);
      });

    const ordenFila = (categoria: string) => {
      const fila = FILA_DE[categoria] ?? 'accessory';
      return (Object.keys(FILAS) as FilaId[]).indexOf(fila);
    };

    const renderChips = () => {
      if (!chips) return;
      chips.innerHTML = TEMPORADAS.map((t) => {
        const activa = temporadas.has(t);
        return `<button type="button" class="dm-chip${activa ? ' active' : ''}" data-temp="${esc(t)}" aria-pressed="${activa}">${activa ? '✓ ' : ''}${esc(t)}</button>`;
      }).join('');

      if (filterCount) {
        filterCount.textContent = String(temporadas.size);
        filterCount.classList.toggle('hidden', temporadas.size === 0);
      }
      chips.querySelectorAll<HTMLButtonElement>('[data-temp]').forEach((chip) => {
        chip.addEventListener('click', () => {
          const temp = chip.dataset.temp!;
          if (temporadas.has(temp)) temporadas.delete(temp);
          else temporadas.add(temp);
          renderChips();
          renderTodo();
        });
      });
    };

    const tarjeta = (p: Prenda) => {
      const activa = seleccion.has(p.id);
      return `<button type="button" data-dm-id="${esc(p.id)}" class="dm-card${activa ? ' picked' : ''}" aria-pressed="${activa}" title="${esc(p.nombre)}">
        <span class="dm-card-photo">${
          p.foto_url
            ? `<img src="${esc(p.foto_url)}" alt="${esc(p.nombre)}" loading="lazy" />`
            : `<span class="dm-emoji">${EMOJI[p.categoria] ?? '👕'}</span>`
        }</span>
        <span class="dm-card-name">${esc(p.nombre)}</span>
        <span class="dm-card-cat">${esc(p.categoria)}</span>
      </button>`;
    };

    const renderRows = () => {
      const disponibles = visibles();
      (Object.keys(FILAS) as FilaId[]).forEach((fila) => {
        const track = document.getElementById(`dm-track-${fila}`);
        const count = document.getElementById(`dm-count-${fila}`);
        const opciones = disponibles.filter((p) => FILAS[fila].includes(p.categoria));
        if (!track) return;
        track.innerHTML = opciones.length
          ? opciones.map(tarjeta).join('')
          : '<span class="dm-row-empty">Sin prendas en esta fila</span>';
        if (count) count.textContent = `${opciones.length}`;
      });
    };

    const renderPreview = () => {
      if (!preview || !saveButton || !selectedCount) return;
      const elegidas = prendas
        .filter((p) => seleccion.has(p.id))
        .sort((a, b) => ordenFila(a.categoria) - ordenFila(b.categoria))
        .slice(0, 4);

      preview.classList.toggle('single', elegidas.length === 1);
      preview.innerHTML =
        elegidas.length === 0
          ? `<div class="preview-empty">
               <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/></svg>
               <span>Tu look está vacío</span>
               <small>Toca una prenda o pulsa Mezclar</small>
             </div>`
          : elegidas
              .map(
                (p) => `
              <div class="preview-piece">
                ${
                  p.foto_url
                    ? `<img src="${esc(p.foto_url)}" alt="${esc(p.nombre)}" loading="lazy" />`
                    : `<div style="font-size:30px">${EMOJI[p.categoria] ?? '👕'}</div>`
                }
                <span>${esc(p.nombre)}</span>
              </div>`
              )
              .join('');

      selectedCount.textContent = `${seleccion.size} PRENDA${seleccion.size === 1 ? '' : 'S'}`;
      saveButton.disabled = seleccion.size === 0;
    };

    const renderTodo = () => {
      panel?.classList.toggle('hidden', prendas.length === 0);
      empty?.classList.toggle('hidden', prendas.length > 0);
      if (counter) {
        counter.textContent = prendas.length
          ? `${visibles().length} prendas · ${seleccion.size} en tu look`
          : 'Cargando…';
      }
      renderRows();
      renderPreview();
    };

    rowsEl?.addEventListener('click', (event) => {
      const boton = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-dm-id]');
      if (!boton) return;
      const id = boton.dataset.dmId!;
      if (seleccion.has(id)) {
        seleccion.delete(id);
      } else {
        const prenda = prendas.find((p) => p.id === id);
        const fila = prenda ? FILA_DE[prenda.categoria] : undefined;
        if (fila) {
          [...seleccion].forEach((otro) => {
            const p = prendas.find((x) => x.id === otro);
            if (p && FILA_DE[p.categoria] === fila) seleccion.delete(otro);
          });
        }
        seleccion.add(id);
      }
      renderTodo();
    });

    const mezclar = () => {
      if (!visibles().length) {
        showError('Añade prendas al armario para poder mezclar un look.');
        return;
      }
      const tracks = document.querySelectorAll<HTMLElement>('.dm-track');
      tracks.forEach((track, i) => {
        track.classList.remove('dm-flip');
        void track.offsetWidth;
        track.style.setProperty('--dm-delay', `${i * 70}ms`);
        track.classList.add('dm-flip');
      });
      setTimeout(() => {
        seleccion.clear();
        (Object.keys(FILAS) as FilaId[]).forEach((fila) => {
          const opciones = visibles().filter((p) => FILAS[fila].includes(p.categoria));
          if (opciones.length) seleccion.add(opciones[Math.floor(Math.random() * opciones.length)].id);
        });
        if (nameInput && !nameInput.value.trim()) {
          nameInput.value = `Look del ${new Date().toLocaleDateString('es-ES')}`;
        }
        renderTodo();
        showSaved('Nuevo look listo 🎲');
      }, 190);
      setTimeout(() => tracks.forEach((track) => track.classList.remove('dm-flip')), 700);
    };

    shuffleButton?.addEventListener('click', mezclar);

    filtersToggle?.addEventListener('click', () => {
      const abrir = filters?.classList.contains('hidden') ?? false;
      filters?.classList.toggle('hidden', !abrir);
      filtersToggle.setAttribute('aria-expanded', String(abrir));
    });

    const renderOutfits = () => {
      if (!listEl || !noOutfits) return;
      const porId = new Map(prendas.map((p) => [p.id, p]));
      const thumb = (p?: Prenda) =>
        p
          ? `<div class="outfit-thumb">${
              p.foto_url
                ? `<img src="${esc(p.foto_url)}" alt="${esc(p.nombre)}" loading="lazy" />`
                : `<span style="font-size:24px">${EMOJI[p.categoria] ?? '👕'}</span>`
            }</div>`
          : '<div class="outfit-thumb empty-thumb" aria-hidden="true"></div>';

      listEl.innerHTML = outfits
        .map((o) => {
          const items = o.prenda_ids.map((id) => porId.get(id)).filter((p): p is Prenda => Boolean(p));
          const visiblesItems = items.slice(0, 4);
          const fecha = new Date(o.creado_en).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
          return `
          <article class="outfit-card">
            <div class="outfit-collage">
              ${Array.from({ length: 4 }, (_, i) => thumb(visiblesItems[i])).join('')}
              ${items.length > 4 ? `<span class="more-count">+${items.length - 4}</span>` : ''}
            </div>
            <div class="outfit-info">
              <div><h3>${esc(o.nombre)}</h3><span>${o.prenda_ids.length} prendas · ${fecha}</span></div>
              <div class="outfit-actions">
                <button type="button" data-del-outfit="${esc(o.id)}" class="icon-btn danger" title="Eliminar outfit">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
                </button>
              </div>
            </div>
          </article>`;
        })
        .join('');

      noOutfits.classList.toggle('hidden', outfits.length > 0);

      listEl.querySelectorAll<HTMLButtonElement>('[data-del-outfit]').forEach((button) => {
        button.addEventListener('click', async () => {
          const id = button.dataset.delOutfit!;
          const outfit = outfits.find((o) => o.id === id);
          if (!outfit || !confirm(`¿Eliminar el outfit «${outfit.nombre}»?`)) return;
          try {
            await deleteOutfit(id);
            outfits = outfits.filter((o) => o.id !== id);
            renderOutfits();
          } catch (error) {
            showError((error as Error).message);
          }
        });
      });
    };

    saveForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (seleccion.size === 0) return;
      const nombre = nameInput?.value.trim() || `Look del ${new Date().toLocaleDateString('es-ES')}`;
      if (saveButton) {
        saveButton.disabled = true;
        saveButton.textContent = 'Guardando…';
      }
      try {
        const user = await requireUser();
        const outfit = await insertOutfit(user.id, nombre, [...seleccion]);
        outfits = [outfit, ...outfits];
        seleccion.clear();
        if (nameInput) nameInput.value = '';
        renderTodo();
        renderOutfits();
        showSaved('Outfit guardado ✅');
      } catch (error) {
        showError((error as Error).message);
      } finally {
        if (saveButton) {
          saveButton.textContent = 'Guardar outfit';
          saveButton.disabled = seleccion.size === 0;
        }
      }
    });

    (async () => {
      if (!supabaseConfigured) return showError('Falta configurar Supabase: copia .env.example a .env');
      try {
        const user = await requireUser();
        [prendas, outfits] = await Promise.all([fetchPrendas(user.id), fetchOutfits(user.id)]);
        renderChips();
        renderTodo();
        renderOutfits();
      } catch (error) {
        if ((error as Error).message !== 'Sesión no iniciada') showError((error as Error).message);
      }
    })();
  </script>
</Layout>
