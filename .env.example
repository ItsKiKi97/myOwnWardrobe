# Copia este archivo como `.env` y rellena los valores de tu proyecto Supabase
# (Supabase -> Project Settings -> API).
# Estas dos variables son públicas por diseño: solo dan acceso a lo que
# permiten las políticas RLS de la base de datos.
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Acepta la clave `anon` antigua (eyJ...) o la `publishable` nueva (sb_publishable_...)
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Opcionales: solo si tu URL/base no coincide con la calculada automáticamente
# PUBLIC_SITE_URL=https://TU-USUARIO.github.io
# PUBLIC_BASE_PATH=/armario
